#!/usr/bin/env bash
# Launcher for baton hooks. Finds a Python that can run baton, then runs the hook CLI.
# Fails open: if baton cannot be found, exit 0 so the host session is never affected.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/../src"
[ -d "$SRC/baton" ] && export PYTHONPATH="$SRC${PYTHONPATH:+:$PYTHONPATH}"

# Interpreter discovery, in order: $BATON_PYTHON, the repo's .venv (made by the quickstart),
# the interpreter named by the `baton` console script on PATH, then any python3/python that can
# import baton and falkordb. Nothing to edit for the documented install.
pick_python() {
  local c b
  for c in "${BATON_PYTHON:-}" "$ROOT/../.venv/bin/python" "$ROOT/.venv/bin/python"; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  done
  b="$(command -v baton 2>/dev/null)" && [ -n "$b" ] && {
    c="$(head -n1 "$b" 2>/dev/null | sed -n 's/^#!//p' | awk '{print $1}')"
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  }
  for c in python3 python; do
    command -v "$c" >/dev/null 2>&1 && "$c" -c 'import baton, falkordb' >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}

PY="$(pick_python)" || exit 0
exec "$PY" -B -m baton.hooks.cli "$@"
